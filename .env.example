# Carbon emission estimates (https://www.climatiq.io)
CLIMATIQ_API_KEY=

# Geocoding of city names (https://opencagedata.com)
OPENCAGE_API_KEY=

# LLM advisor summaries (https://openrouter.ai)
OPENROUTER_API_KEY=

# Neon serverless PostgreSQL connection string for user accounts
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=

# Random secret used to sign the Streamlit auth cookie
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET=

# Only needed when the UI and Rasa run in separate containers.
# Leave unset for local runs; docker-compose sets it automatically.
# RASA_BASE_URL=http://localhost:5005
